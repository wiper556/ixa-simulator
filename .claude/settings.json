{
  "permissions": {
    "allow": [
      "WebFetch(domain:sengokuixa.jp)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"(New-Object Media.SoundPlayer 'C:\\Windows\\Media\\Ring07.wav').PlaySync()\"",
            "statusMessage": "完了通知音を再生中..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"(New-Object Media.SoundPlayer 'c:\\Users\\uesug\\ixa-simulator\\.claude\\sounds\\notify_bell.wav').PlaySync()\"",
            "statusMessage": "確認の通知音を再生中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/hooks/no_heredoc_backslash.py\"",
            "timeout": 15,
            "statusMessage": "T-01(ヒアドキュメントのバックスラッシュ)を確認中"
          }
        ]
      }
    ]
  }
}
