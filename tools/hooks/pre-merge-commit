#!/bin/sh
# A-6(2026-08-12レッドチーム指摘)への対応。
# git merge が作るコミットでは pre-commit が呼ばれない。worktree運用でマージが日常なので、
# 「マージなら監査を通さずに入れられる」という抜け道になっていた。
#
# ※ fast-forward マージと、コンフリクト解決後の git commit は
#    このフックを通らない(前者はコミットを作らない/後者は pre-commit を通る)。
#    どちらも最終的には pre-push と CI が受け止める。
#
# Z-1(第5回): -P 起動 + tools/ の未追跡 .py の事前確認(import乗っ取り対策)。

STRAY=$(git status --porcelain -- tools | grep '^??' | grep '\.py$' || true)
if [ -n "$STRAY" ]; then
  echo "[停止] tools/ に追跡されていない .py がある(import乗っ取り対策・第5回 Z-1)"
  echo "$STRAY"
  exit 1
fi

exec python -P tools/precommit_check.py --mode merge
